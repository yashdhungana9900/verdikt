[Unit]
Description=Verdikt server
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
User=verdikt
Group=verdikt
SupplementaryGroups=docker
WorkingDirectory=/opt/verdikt
EnvironmentFile=/opt/verdikt/.env
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=3
# Note: no PrivateTmp. The judge shares temp folders with Docker containers.

[Install]
WantedBy=multi-user.target
