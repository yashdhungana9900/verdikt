{
  "name": "verdikt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,judge -c blue,magenta \"vite\" \"node --watch server/index.js\"",
    "dev:local": "concurrently -k -n web,judge -c blue,magenta \"vite\" \"node --watch server/index.js --local\"",
    "dev:web": "vite",
    "server": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "judge:pull": "docker pull node:20-slim && docker pull python:3.12-slim && docker build -t verdikt-cpp server/images/cpp",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "predev": "docker compose up -d db || echo Database not started - is Docker Desktop running?",
    "predev:local": "docker compose up -d db || echo Database not started - is Docker Desktop running?"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^14.3.0",
    "lucide-react": "^1.58.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  }
}
